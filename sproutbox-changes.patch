-4. DATABASE SCHEMA (PRISMA)
-================================================================================
-
-// prisma/schema.prisma
-
-generator client {
-  provider = "prisma-client-js"
-}
-
-datasource db {
-  provider = "postgresql"
-  url      = env("DATABASE_URL")
-}
-
-enum Role {
-  ADMIN
-  GROWER
-  RESTAURANT
-}
-
-enum OrderStatus {
-  PENDING_PAYMENT
-  CONFIRMED
-  IN_PRODUCTION
-  AT_HUB
-  IN_TRANSIT
-  DELIVERED
-  CANCELLED
-}
-
-enum TaskStatus {
-  ASSIGNED
-  IN_PROGRESS
-  HARVEST_READY
-  HARVESTED
-  CANCELLED
-}
-
-enum BatchStatus {
-  SOWING
-  GROWING
-  PRE_HARVEST
-  QC_PENDING
-  QC_PASSED
-  QC_FAILED
-  HARVESTED
-  REJECTED
-}
-
-enum QCResult {
-  PASS
-  RISK
-  REJECT
-}
-
-enum PayoutStatus {
-  PENDING
-  PROCESSING
-  PAID
-  FAILED
-}
-
-enum DeliveryStatus {
-  PREPARING
-  PACKED
-  IN_TRANSIT
-  DELIVERED
-  FAILED
-}
-
-model User {
-  id            String    @id @default(cuid())
-  email         String    @unique
-  emailVerified DateTime?
-  passwordHash  String?
-  name          String?
-  image         String?
-  role          Role      @default(GROWER)
-  createdAt     DateTime  @default(now())
-  updatedAt     DateTime  @updatedAt
-  grower        Grower?
-  restaurant    Restaurant?
-  accounts      Account[]
-  sessions      Session[]
-}
-
-model Grower {
-  id              String    @id @default(cuid())
-  userId          String    @unique
-  user            User      @relation(fields: [userId], references: [id])
-  phone           String
-  address         String
-  city            String
-  pincode         String
-  lat             Float?
-  lng             Float?
-  clusterId       String?
-  cluster         Cluster?  @relation(fields: [clusterId], references: [id])
-  kitSize         Int       @default(5)   // number of trays in kit
-  spaceAvailable  Int?      // sqft
-  spacePhotoUrl   String?
-  bankAccount     String?
-  bankIFSC        String?
-  upiId           String?
-  // Performance scores (0.0 to 1.0)
-  yieldScore      Float     @default(0.5)
-  qualityScore    Float     @default(0.5)
-  timelinessScore Float     @default(0.5)
-  compositeScore  Float     @default(0.5)
-  totalEarnings   Float     @default(0)
-  isActive        Boolean   @default(true)
-  joinedAt        DateTime  @default(now())
-  tasks           Task[]
-  payouts         Payout[]
-}
-
-model Restaurant {
-  id               String    @id @default(cuid())
-  userId           String    @unique
-  user             User      @relation(fields: [userId], references: [id])
-  businessName     String
-  gstin            String?
-  address          String
-  city             String
-  pincode          String
-  contactName      String
-  phone            String
-  cuisineType      String?
-  stripeCustomerId String?
-  isActive         Boolean   @default(true)
-  orders           Order[]
-  feedbacks        Feedback[]
-}
-
-model Order {
-  id              String        @id @default(cuid())
-  restaurantId    String
-  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id])
-  cropType        String
-  quantityKg      Float
-  deliveryDate    DateTime
-  recurrence      String?       // "weekly", "biweekly", null for one-time
-  status          OrderStatus   @default(PENDING_PAYMENT)
-  totalPrice      Float
-  stripePaymentId String?
-  notes           String?
-  createdAt       DateTime      @default(now())
-  updatedAt       DateTime      @updatedAt
-  productionPlan  ProductionPlan?
-  delivery        Delivery?
-  feedback        Feedback?
-}
-
-model ProductionPlan {
-  id            String    @id @default(cuid())
-  orderId       String    @unique
-  order         Order     @relation(fields: [orderId], references: [id])
-  totalKg       Float
-  totalTrays    Int
-  bufferTrays   Int
-  bufferPercent Float     @default(0.25)
-  sowDate       DateTime
-  harvestDate   DateTime
-  status        String    @default("DRAFT")  // DRAFT, ACTIVE, COMPLETE
-  createdAt     DateTime  @default(now())
-  tasks         Task[]
-}
-
-model Task {
-  id           String        @id @default(cuid())
-  planId       String
-  plan         ProductionPlan @relation(fields: [planId], references: [id])
-  growerId     String
-  grower       Grower        @relation(fields: [growerId], references: [id])
-  cropType     String
-  trayCount    Int
-  sowDate      DateTime
-  harvestDate  DateTime
-  status       TaskStatus    @default(ASSIGNED)
-  allocatedAt  DateTime      @default(now())
-  batches      Batch[]
-}
-
-model Batch {
-  id              String       @id @default(cuid())
-  taskId          String
-  task            Task         @relation(fields: [taskId], references: [id])
-  trayNumber      Int          // tray index within task
-  currentDay      Int          @default(0)
-  status          BatchStatus  @default(SOWING)
-  actualYieldGrams Int?
-  harvestImageUrl String?
-  harvestedAt     DateTime?
-  createdAt       DateTime     @default(now())
-  checkIns        CheckIn[]
-  payout          Payout?
-}
-
-model CheckIn {
-  id           String    @id @default(cuid())
-  batchId      String
-  batch        Batch     @relation(fields: [batchId], references: [id])
-  day          Int
-  imageTopUrl  String?
-  imageSideUrl String?
-  notes        String?
-  qcResult     QCResult?
-  qcNotes      String?
-  qcReviewedAt DateTime?
-  qcReviewedBy String?   // admin userId
-  createdAt    DateTime  @default(now())
-}
-
-model Cluster {
-  id         String    @id @default(cuid())
-  name       String
-  city       String
-  lat        Float
-  lng        Float
-  radiusKm   Float     @default(3.0)
-  growers    Grower[]
-  hubs       Hub[]
-}
-
-model Hub {
-  id           String     @id @default(cuid())
-  name         String
-  address      String
-  clusterId    String
-  cluster      Cluster    @relation(fields: [clusterId], references: [id])
-  lat          Float
-  lng          Float
-  dropoffStart String     // "08:00"
-  dropoffEnd   String     // "11:00"
-  isActive     Boolean    @default(true)
-  deliveries   Delivery[]
-}
-
-model Delivery {
-  id           String         @id @default(cuid())
-  orderId      String         @unique
-  order        Order          @relation(fields: [orderId], references: [id])
-  hubId        String
-  hub          Hub            @relation(fields: [hubId], references: [id])
-  status       DeliveryStatus @default(PREPARING)
-  driverName   String?
-  driverPhone  String?
-  packedAt     DateTime?
-  dispatchedAt DateTime?
-  deliveredAt  DateTime?
-  createdAt    DateTime       @default(now())
-}
-
-model Feedback {
-  id           String     @id @default(cuid())
-  orderId      String     @unique
-  order        Order      @relation(fields: [orderId], references: [id])
-  restaurantId String
-  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
-  rating       Int        // 1-5
-  notes        String?
-  imageUrl     String?
-  createdAt    DateTime   @default(now())
-}
-
-model Payout {
-  id        String       @id @default(cuid())
-  growerId  String
-  grower    Grower       @relation(fields: [growerId], references: [id])
-  batchId   String       @unique
-  batch     Batch        @relation(fields: [batchId], references: [id])
-  amount    Float
-  status    PayoutStatus @default(PENDING)
-  paidAt    DateTime?
-  createdAt DateTime     @default(now())
-}
-
-model Notification {
-  id        String   @id @default(cuid())
-  userId    String
-  title     String
-  message   String
-  type      String   // "QC_RESULT" | "TASK_ASSIGNED" | "PAYOUT" | "DELIVERY"
-  read      Boolean  @default(false)
-  createdAt DateTime @default(now())
-}
-
-// NextAuth required models
-model Account {
-  id                String  @id @default(cuid())
-  userId            String
-  type              String
-  provider          String
-  providerAccountId String
-  refresh_token     String? @db.Text
-  access_token      String? @db.Text
-  expires_at        Int?
-  token_type        String?
-  scope             String?
-  id_token          String? @db.Text
-  session_state     String?
-  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
-  @@unique([provider, providerAccountId])
-}
-
-model Session {
-  id           String   @id @default(cuid())
-  sessionToken String   @unique
-  userId       String
-  expires      DateTime
-  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
-}
-
-model VerificationToken {
-  identifier String
-  token      String   @unique
-  expires    DateTime
-  @@unique([identifier, token])
-}
-
