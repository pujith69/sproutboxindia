-  return scored.map((g, i) => {
-    const trays =
-      i === scored.length - 1
-        ? totalTrays - assigned
-        : Math.max(1, Math.round((g.combinedScore / totalScore) * totalTrays));
-    assigned += trays;
-    return { ...g, trayCount: trays };
-  });
-}
