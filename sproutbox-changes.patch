+            </table>
+          </div>
+        </motion.div>
+      )}
+
+      {/* 3. QC OPERATIONS */}
+      {activeTab === "qc" && (
+        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="space-y-4">
+          {qcPending.length === 0 ? (
+            <div className="text-center p-12 border border-white/[0.06] rounded-2xl bg-white/[0.02]">
+              <span className="text-4xl opacity-50">✅</span>
