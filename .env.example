# ── NextAuth ──────────────────────────────────────────────────────────────────
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Database (Supabase / Neon PostgreSQL) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Analytics (PostHog) ───────────────────────────────────────────────────────
# Ask the owner for the project key before enabling tracking in production.
# Consent banner / privacy policy sign-off required first (India DPDP Act).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── QA override for experiments ───────────────────────────────────────────────
# Allow ?sb_force=<experiment>:<variant> outside production.
ALLOW_FORCE_VARIANT=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
